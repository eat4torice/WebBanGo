@model Product

@{
    ViewData["Title"] = Model.Name;
    var relatedProducts = ViewBag.RelatedProducts as IEnumerable<Product>;
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Index">Sản phẩm</a></li>
            @if (Model.Category != null)
            {
                <li class="breadcrumb-item">
                    <a asp-controller="Products" asp-action="Index" asp-route-categoryId="@Model.CategoryId">
                        @Model.Category.Name
                    </a>
                </li>
            }
            <li class="breadcrumb-item active">@Model.Name</li>
        </ol>
    </nav>

    <div class="row">
        <!-- Product Image -->
        <div class="col-md-5">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="img-fluid rounded" alt="@Model.Name">
            }
            else
            {
                <div class="bg-secondary d-flex align-items-center justify-content-center rounded" style="height: 400px;">
                    <span class="text-white fs-4">No Image Available</span>
                </div>
            }
        </div>

        <!-- Product Info -->
        <div class="col-md-7">
            <h2>@Model.Name</h2>
            <p class="text-muted">SKU: @Model.Sku</p>
            
            <div class="mb-3">
                <span class="badge bg-primary">@Model.Category?.Name</span>
                @if (Model.StockQuantity > 0)
                {
                    <span class="badge bg-success">Còn hàng</span>
                }
                else
                {
                    <span class="badge bg-danger">Hết hàng</span>
                }
            </div>

            <h3 class="text-primary mb-3">@Model.Price.ToString("N0") VNĐ / @Model.Unit</h3>

            <table class="table table-borderless">
                <tr>
                    <th width="150">Loại gỗ:</th>
                    <td>@Model.WoodType</td>
                </tr>
                @if (!string.IsNullOrEmpty(Model.Dimensions))
                {
                    <tr>
                        <th>Kích thước:</th>
                        <td>@Model.Dimensions</td>
                    </tr>
                }
                @if (!string.IsNullOrEmpty(Model.MoistureLevel))
                {
                    <tr>
                        <th>Độ ẩm:</th>
                        <td>@Model.MoistureLevel</td>
                    </tr>
                }
                @if (!string.IsNullOrEmpty(Model.Origin))
                {
                    <tr>
                        <th>Nguồn gốc:</th>
                        <td>@Model.Origin</td>
                    </tr>
                }
                <tr>
                    <th>Tồn kho:</th>
                    <td>@Model.StockQuantity.ToString("N2") @Model.Unit</td>
                </tr>
            </table>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="mt-3">
                    <h5>Mô tả sản phẩm:</h5>
                    <p>@Model.Description</p>
                </div>
            }

            <div class="mt-4">
                <button class="btn btn-primary btn-lg" @(Model.StockQuantity > 0 ? "" : "disabled")>
                    🛒 Thêm vào giỏ hàng
                </button>
                <button class="btn btn-outline-secondary btn-lg">
                    ❤️ Yêu thích
                </button>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    @if (relatedProducts != null && relatedProducts.Any())
    {
        <div class="mt-5">
            <h4 class="mb-3">Sản phẩm liên quan</h4>
            <div class="row">
                @foreach (var product in relatedProducts)
                {
                    <div class="col-md-3 mb-4">
                        <div class="card h-100">
                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height: 150px; object-fit: cover;">
                            }
                            else
                            {
                                <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 150px;">
                                    <span class="text-white">No Image</span>
                                </div>
                            }
                            <div class="card-body">
                                <h6 class="card-title">@product.Name</h6>
                                <p class="text-primary fw-bold">@product.Price.ToString("N0") VNĐ</p>
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" 
                                   class="btn btn-outline-primary btn-sm w-100">Xem chi tiết</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
